# ============================================================
# Tech Radar — biến môi trường (mẫu, KHÔNG chứa secret)
# Sao chép thành .env khi bắt đầu dev. Không commit .env thật.
# ============================================================

# --- Database (PostgreSQL) ---
# Chưa xác minh máy có PostgreSQL; sẽ kiểm chứng ở Phase 2.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tech_radar

# --- API ---
API_HOST=0.0.0.0
API_PORT=3000

# --- Worker / scheduling ---
# Cron cho vòng thu thập tự động. Mặc định 6 giờ/lần.
WORKER_CRON_SCHEDULE=0 */6 * * *

# --- Scraping (tôn trọng nguồn; không bypass) ---
# Độ trễ tối thiểu giữa các request tới cùng một nguồn.
SCRAPE_POLITE_DELAY_MS=1500
# User-Agent: mô tả bot và liên hệ chủ dự án (điền khi thật sự chạy).
SCRAPE_USER_AGENT=TechRadarBot/0.1 (+https://github.com/OWNER/tech-radar)

# --- Logging ---
LOG_LEVEL=info
